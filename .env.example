# Шаблон переменных окружения. Значения сюда не вписываются — этот файл в git.
# Реальные значения задаются там, где указано ниже.

# ---------------------------------------------------------------------------
# СЕКРЕТЫ — только на сервере (Supabase → Edge Functions → Secrets).
# Во frontend не попадают никогда.
# ---------------------------------------------------------------------------

# Токен бота из @BotFather. Им проверяется подпись Telegram initData.
# Добавить в Supabase Dashboard → Project Settings → Edge Functions → Secrets.
TELEGRAM_BOT_TOKEN=

# SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY подставляются в Edge Function
# автоматически — вручную их задавать не нужно.
# Service role key нигде не должен появляться во frontend-коде.

# ---------------------------------------------------------------------------
# ПУБЛИЧНЫЕ значения — лежат в js/config.js, секретом не являются.
# Доступа к таблицам не дают: RLS включён, политик нет, всё идёт через
# Edge Function.
# ---------------------------------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=
